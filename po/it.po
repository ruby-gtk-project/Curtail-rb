msgstr "Mantiene i blocchi di metadati che non influiscono sul rendering"

#: data/ui/preferences.blp:45
msgid "Keep File Attributes When Possible"
msgstr "Mantienere gli attributi dei file, se possibile"

#: data/ui/preferences.blp:46
msgid ""
"Ensure the new file has the same permissions and timestamps as the original "
"file"
msgstr ""
"Il nuovo file avrà gli stessi permessi e la stessa datazione del file "
"originale"

#: data/ui/preferences.blp:51
msgid "Set the timeout between images"
msgstr "Imposta il limite di tempo tra le immagini"

